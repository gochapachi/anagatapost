# Copy to `.env` (excluded by both .gitignore and .dockerignore) and fill in real
# values. `docker-compose.yml` refuses to start when a REQUIRED value is missing,
# and the container refuses to boot in production without NEXTAUTH_SECRET,
# NEXTAUTH_URL or DATABASE_URL.

# --- App -----------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="https://post.anagataitsolutions.in"

# --- Auth (REQUIRED) -----------------------------------------------------------
# Public origin; pins the OAuth callback so a spoofed Host header cannot steer it.
NEXTAUTH_URL="https://post.anagataitsolutions.in"
# Signs session JWTs. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Google OAuth (optional — email + password login works without it)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Operator bootstrap --------------------------------------------------------
# Comma-separated emails forced to the ADMIN role until roles live in Postgres.
ADMIN_EMAILS=""

# --- Database (REQUIRED with docker-compose) -----------------------------------
POSTGRES_PASSWORD=""
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/anagatapost?schema=public"

# --- Payments (Cashfree v3 API) ------------------------------------------------
# Empty credentials = development simulation, refused in production.
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
CASHFREE_ENVIRONMENT="TEST" # TEST or PROD
CASHFREE_API_VERSION="2023-08-01"
NEXT_PUBLIC_CASHFREE_ENVIRONMENT="TEST" # TEST or PROD

# --- WhatsApp Dispatch Alerts (Evolution API) ---------------------------------
EVOLUTION_API_URL="https://evo.anagataitsolutions.in"
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE_NAME="anagata-post"

# --- n8n Workflow Automation ---------------------------------------------------
N8N_WEBHOOK_URL="https://n8n.anagataitsolutions.in/webhook/anagatapost-events"
